# Server-side URL of the Java monolith. Never expose database or mail credentials here.
MYCELIUM_BACKEND_URL=http://localhost:8080

# The same Google OAuth Web client ID must be set as GOOGLE_CLIENT_ID on the Java backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_EFI_PAYEE_CODE=
NEXT_PUBLIC_EFI_SANDBOX=false

# Optional browser-visible values used by the existing storefront.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_COUPON_CODE=
NEXT_PUBLIC_COUPON_DISCOUNT_VALUE=
NEXT_PUBLIC_COUPON_LANCAMENTO_CODE=
NEXT_PUBLIC_COUPON_LANCAMENTO_DISCOUNT_VALUE=
